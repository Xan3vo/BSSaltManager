<Application x:Class="BssManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BssManager.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Palette first: Controls resolves its StaticResources against
                 it, and a merged dictionary can only see what was merged
                 before it. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Palette.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <views:HealthStateToBrushConverter x:Key="HealthBrush" />
            <views:HealthStateToGlyphConverter x:Key="HealthGlyph" />
            <views:SessionStateToBrushConverter x:Key="SessionBrush" />
            <views:BoolToVisibilityConverter x:Key="BoolToVis" />
            <views:CanFixToVisibilityConverter x:Key="CanFixToVis" />
            <views:StateToTintConverter x:Key="Tint" />
            <views:EmptyStringToVisibilityConverter x:Key="EmptyToVis" />
            <views:InitialConverter x:Key="Initial" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
