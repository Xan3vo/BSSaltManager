<Window x:Class="BssManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BssManager.ViewModels"
        xmlns:views="clr-namespace:BssManager.Views"
        Title="BSS Alt Manager"
        Icon="Assets/appicon.ico"
        Height="800" Width="1240"
        MinHeight="600" MinWidth="1000"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        StateChanged="Window_StateChanged">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding GoToSessionsCommand}" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding GoToAccountsCommand}" />
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding GoToHealthCommand}" />
    </Window.InputBindings>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- ============================================================ chips ==

             The facts about a row, one per box. The same facts joined by spaces
             into a single grey line is what they used to be, and nothing in
             that line could be picked out at a glance. -->
        <DataTemplate x:Key="AltChips">
            <WrapPanel Margin="0,9,0,0">
                <Border Style="{StaticResource Chip}">
                    <TextBlock Text="{Binding WindowsUsername}" Style="{StaticResource ChipText}" />
                </Border>
                <Border Style="{StaticResource Chip}">
                    <TextBlock Text="{Binding Target}" Style="{StaticResource ChipText}"
                               FontFamily="{StaticResource MonoFont}" />
                </Border>
                <Border Style="{StaticResource Chip}">
                    <TextBlock Text="{Binding Resolution}" Style="{StaticResource ChipText}" />
                </Border>

                <!-- Blue rather than grey: a configured private server changes
                     where the session lands, so it is a decision, not a fact. -->
                <Border Style="{StaticResource Chip}" Background="#101C33" BorderBrush="#25406E"
                        Visibility="{Binding ServerText, Converter={StaticResource EmptyToVis}}">
                    <TextBlock Text="{Binding ServerText}" Style="{StaticResource ChipText}"
                               Foreground="{StaticResource AccentHi}" />
                </Border>

                <Border Style="{StaticResource Chip}">
                    <TextBlock Text="{Binding MacroSummary}" Style="{StaticResource ChipText}" />
                </Border>

                <Border Style="{StaticResource Chip}"
                        Visibility="{Binding LastRunText, Converter={StaticResource EmptyToVis}}">
                    <TextBlock Text="{Binding LastRunText}" Style="{StaticResource ChipText}" />
                </Border>

                <!-- Amber, and only ever present when it is true. An alt that
                     has not signed in yet will land on somebody else's Roblox. -->
                <Border Style="{StaticResource Chip}" Background="#241C0C" BorderBrush="#4A3A17"
                        Visibility="{Binding NeedsSignIn, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="needs sign-in" Style="{StaticResource ChipText}"
                               Foreground="{StaticResource Warn}" />
                </Border>
            </WrapPanel>
        </DataTemplate>

        <!-- =========================================================== an RDP ==

             Facts on top, controls in a footer under a rule. Splitting the two
             is what stopped the row reading as a wall of small text with
             buttons buried in it. -->
        <DataTemplate x:Key="AltCard" DataType="{x:Type vm:AltRowViewModel}">
            <Border x:Name="CardRoot" Style="{StaticResource FadeInCard}"
                    Padding="0" Margin="0,0,0,10">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ................................................. facts -->
                    <Grid Grid.Row="0" Margin="16,15,16,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- A tile in the session's own colour. Gives every row
                             an anchor at the same x, which is what makes a long
                             list scannable. -->
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                VerticalAlignment="Top" Margin="0,1,14,0" BorderThickness="1"
                                Background="{Binding State, Converter={StaticResource Tint}, ConverterParameter=28}"
                                BorderBrush="{Binding State, Converter={StaticResource Tint}, ConverterParameter=70}">
                            <TextBlock Text="{Binding DisplayName, Converter={StaticResource Initial}}"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{Binding State, Converter={StaticResource SessionBrush}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CardTitle}"
                                           VerticalAlignment="Center" />

                                <Border CornerRadius="20" Padding="9,3" Margin="10,1,0,0"
                                        VerticalAlignment="Center"
                                        Background="{Binding State, Converter={StaticResource Tint}, ConverterParameter=22}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="5" Height="5" CornerRadius="3" Margin="0,0,7,0"
                                                VerticalAlignment="Center"
                                                Background="{Binding State, Converter={StaticResource SessionBrush}}" />
                                        <TextBlock Text="{Binding StateText}" FontSize="10.5"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{Binding State, Converter={StaticResource SessionBrush}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AltChips}" />

                            <!-- Signing in takes the best part of a minute; a
                                 spinner alone does not say what it waits on. -->
                            <StackPanel Orientation="Horizontal" Margin="1,10,0,0"
                                        Visibility="{Binding Activity, Converter={StaticResource EmptyToVis}}">
                                <ContentControl Style="{StaticResource Spinner}" Width="12" Height="12"
                                                VerticalAlignment="Center" Margin="0,0,9,0" />
                                <TextBlock Text="{Binding Activity}" FontSize="11.5"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentHi}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>

                        <ContentControl Grid.Column="2" Style="{StaticResource Spinner}"
                                        VerticalAlignment="Top" Margin="12,12,2,0"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="{StaticResource LineSoft}" />

                    <!-- ........................................... the controls -->
                    <Grid Grid.Row="2" Margin="14,11,14,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Signs in as" Style="{StaticResource GroupLabel}"
                                       VerticalAlignment="Center" Margin="2,0,10,0" />
                            <!-- An explicit ItemTemplate, not DisplayMemberPath:
                                 the latter leaves the closed box rendering the
                                 item's ToString() rather than its name. -->
                            <ComboBox Width="164" Height="32" VerticalAlignment="Center"
                                      ItemsSource="{Binding DataContext.AccountTargets, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding LinkedAccount, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Kept dim rather than hidden: invisible controls read
                             as a rendering bug and nobody ever finds them.

                             Only what is worth reaching for on a running alt is
                             out here. Repair, Remove and the rest are real but
                             rare, and seven buttons in a row read as clutter
                             rather than as choice. -->
                        <StackPanel x:Name="Secondary" Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.5">

                            <!-- One button for both jobs: the dialog installs the
                                 macro when there is nothing installed, so only
                                 its label changes. -->
                            <Button x:Name="MacroButton" Content="Macro"
                                    Style="{StaticResource GhostButton}"
                                    ToolTip="The private server this alt joins, which field and pattern it runs, and the macro download itself."
                                    Command="{Binding DataContext.MacroCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />

                            <Button Content="Start" Style="{StaticResource GhostButton}"
                                    ToolTip="Starts the macro in this session now. Roblox has to be in the game first."
                                    Command="{Binding DataContext.StartMacroCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />

                            <Button Content="{Binding WindowToggleLabel}" Style="{StaticResource GhostButton}"
                                    MinWidth="50"
                                    ToolTip="Takes this RDP window off the screen and out of the taskbar. The session keeps running and the macro keeps going."
                                    Command="{Binding DataContext.ToggleWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />

                            <!-- Tag carries the view model into the menu: a
                                 ContextMenu lives in its own popup and does not
                                 inherit the card's DataContext, so the commands
                                 would be unreachable without it. -->
                            <Button Style="{StaticResource IconButton}" Margin="2,0,0,0"
                                    ToolTip="Re-run sign-in, detach, log off, repair, remove."
                                    Click="More_Click"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button.Content>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE712;" />
                                </Button.Content>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Run sign-in again"
                                                  Command="{Binding PlacementTarget.Tag.SignInPhaseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem Header="Detach"
                                                  Command="{Binding PlacementTarget.Tag.DisconnectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem Header="Repair"
                                                  Command="{Binding PlacementTarget.Tag.RepairCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Remove" Foreground="{StaticResource Danger}"
                                                  Command="{Binding PlacementTarget.Tag.RemoveAltCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                        </StackPanel>

                        <!-- One on/off control: the two buttons share the cell
                             and never both show. Off shows Launch (starts the
                             session out of sight); on shows Log off. -->
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <Button Content="Launch"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="104" Padding="14,8"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                    Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Log off"
                                    Style="{StaticResource DangerButton}"
                                    MinWidth="104" Padding="14,8"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.LogOffCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Value="True"
                             Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}">
                    <Setter TargetName="Secondary" Property="Opacity" Value="1" />
                    <Setter TargetName="CardRoot" Property="Background" Value="{StaticResource Surface3}" />
                    <Setter TargetName="CardRoot" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                </DataTrigger>

                <!-- The macro button is where the private server is set, so it
                     reads as configured even when the row is not hovered. -->
                <DataTrigger Binding="{Binding HasPrivateServer}" Value="True">
                    <Setter TargetName="MacroButton" Property="Foreground"
                            Value="{StaticResource AccentHi}" />
                    <Setter TargetName="MacroButton" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ======================================================= an account -->
        <DataTemplate x:Key="AccountCard" DataType="{x:Type vm:AccountRowViewModel}">
            <Border x:Name="CardRoot" Style="{StaticResource FadeInCard}"
                    Padding="0" Margin="0,0,0,10">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,15,16,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                VerticalAlignment="Top" Margin="0,1,14,0" BorderThickness="1"
                                Background="{Binding State, Converter={StaticResource Tint}, ConverterParameter=28}"
                                BorderBrush="{Binding State, Converter={StaticResource Tint}, ConverterParameter=70}">
                            <TextBlock Text="{Binding DisplayName, Converter={StaticResource Initial}}"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{Binding State, Converter={StaticResource HealthBrush}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CardTitle}"
                                           VerticalAlignment="Center" />
                                <Border CornerRadius="20" Padding="9,3" Margin="10,1,0,0"
                                        VerticalAlignment="Center"
                                        Background="{Binding State, Converter={StaticResource Tint}, ConverterParameter=22}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="5" Height="5" CornerRadius="3" Margin="0,0,7,0"
                                                VerticalAlignment="Center"
                                                Background="{Binding State, Converter={StaticResource HealthBrush}}" />
                                        <TextBlock Text="{Binding StateText}" FontSize="10.5"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{Binding State, Converter={StaticResource HealthBrush}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <WrapPanel Margin="0,9,0,0">
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock Text="{Binding HandleText}" Style="{StaticResource ChipText}" />
                                </Border>
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock Text="{Binding IdText}" Style="{StaticResource ChipText}"
                                               FontFamily="{StaticResource MonoFont}" />
                                </Border>
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock Text="{Binding CheckedText}" Style="{StaticResource ChipText}" />
                                </Border>
                                <Border x:Name="AssignChip" Style="{StaticResource Chip}">
                                    <TextBlock x:Name="AssignText" Text="{Binding AssignedText}"
                                               Style="{StaticResource ChipText}" />
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <ContentControl Grid.Column="2" Style="{StaticResource Spinner}"
                                        VerticalAlignment="Top" Margin="12,12,2,0"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="{StaticResource LineSoft}" />

                    <StackPanel x:Name="Secondary" Grid.Row="2" Orientation="Horizontal"
                                Margin="12,9,12,9" Opacity="0.5">
                        <Button Content="Check" Style="{StaticResource GhostButton}"
                                ToolTip="Asks Roblox whether this login still works."
                                Command="{Binding DataContext.VerifyAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Profile" Style="{StaticResource GhostButton}"
                                ToolTip="Opens this account's Roblox profile in your normal browser."
                                Command="{Binding DataContext.OpenProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Sign in again" Style="{StaticResource GhostButton}"
                                ToolTip="Replaces an expired login. Sign in as this account and it is refreshed in place."
                                Command="{Binding DataContext.AddAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="Remove" Style="{StaticResource DangerGhostButton}"
                                Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Value="True"
                             Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}">
                    <Setter TargetName="Secondary" Property="Opacity" Value="1" />
                    <Setter TargetName="CardRoot" Property="Background" Value="{StaticResource Surface3}" />
                    <Setter TargetName="CardRoot" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                </DataTrigger>

                <!-- An unassigned account does nothing until it is given an
                     RDP, so that chip is the one worth noticing. -->
                <DataTrigger Binding="{Binding IsAssigned}" Value="False">
                    <Setter TargetName="AssignChip" Property="Background" Value="#241C0C" />
                    <Setter TargetName="AssignChip" Property="BorderBrush" Value="#4A3A17" />
                    <Setter TargetName="AssignText" Property="Foreground" Value="{StaticResource Warn}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ==================================================== a host check -->
        <!-- ====================================================== the sessions -->
        <DataTemplate x:Key="SessionsPage">
            <Grid Style="{StaticResource PageRoot}">
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1280" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="30,24,30,18">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Sessions" Style="{StaticResource PageTitle}" />
                            <Border Background="#122246" CornerRadius="20" BorderBrush="#25406E"
                                    BorderThickness="1" Padding="10,2" Margin="12,4,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding AltCountText}" FontSize="10.5"
                                           FontWeight="SemiBold" Foreground="{StaticResource AccentHi}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource PageSub}"
                                   Text="Each one is its own Windows account, its own loopback address and its own copy of the macro." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="Log off all" Style="{StaticResource GhostButton}"
                                Padding="13,8" Margin="0,0,8,0"
                                Command="{Binding LogOffAllCommand}" />
                        <Button Content="Launch all" Padding="15,8" Margin="0,0,8,0"
                                Command="{Binding LaunchAllCommand}" />
                        <Button Content="Add RDP" Style="{StaticResource PrimaryButton}"
                                Padding="18,8" Command="{Binding AddAltCommand}" />
                    </StackPanel>
                </Grid>

                <!-- The empty state doubles as the first-run instruction. -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="34,30" MaxWidth="520"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,60"
                        Visibility="{Binding HasNoAlts, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Width="50" Height="50" HorizontalAlignment="Left" Margin="0,0,0,20">
                            <Border CornerRadius="14" Background="#122246" BorderThickness="1"
                                    BorderBrush="#25406E" />
                            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}"
                                       FontSize="21" Foreground="{StaticResource AccentHi}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="No RDPs yet" FontSize="16.5" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0"
                                   Text="Clear the host health page first, then add one. Each RDP gets its own Windows account, its own generated password, its own loopback address and a pinned session size." />
                        <Button Content="Add the first RDP" Style="{StaticResource PrimaryButton}"
                                Padding="18,9" HorizontalAlignment="Left" Margin="0,22,0,0"
                                Command="{Binding AddAltCommand}" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" Margin="0,0,4,0" Padding="30,0,26,24"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasNoAlts, Converter={StaticResource BoolToVis},
                                           ConverterParameter=invert}">
                    <!-- Capped so a maximised window does not stretch a card to
                         2000px, stranding Launch far from the name. -->
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Alts}"
                                      ItemTemplate="{StaticResource AltCard}" />

                        <Button Style="{StaticResource AddCard}" Content="Add another RDP"
                                Command="{Binding AddAltCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DataTemplate>

        <!-- ====================================================== the accounts -->
        <DataTemplate x:Key="AccountsPage">
            <Grid Style="{StaticResource PageRoot}">
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1280" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="30,24,30,18">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Accounts" Style="{StaticResource PageTitle}" />
                            <Border Background="#122246" CornerRadius="20" BorderBrush="#25406E"
                                    BorderThickness="1" Padding="10,2" Margin="12,4,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding AccountCountText}" FontSize="10.5"
                                           FontWeight="SemiBold" Foreground="{StaticResource AccentHi}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource PageSub}"
                                   Text="Roblox logins this app can hand to a session. The password goes to Roblox, never to this app." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="Check all" Style="{StaticResource GhostButton}"
                                Padding="13,8" Margin="0,0,8,0"
                                ToolTip="Asks Roblox whether every saved login still works."
                                Command="{Binding VerifyAllAccountsCommand}" />
                        <Button Content="Add account" Style="{StaticResource PrimaryButton}"
                                Padding="18,8" Command="{Binding AddAccountCommand}" />
                    </StackPanel>
                </Grid>

                <!-- The empty state explains what Add account actually does,
                     since typing a password into a window this app opened
                     deserves an explanation before, not after. -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="34,30" MaxWidth="520"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,60"
                        Visibility="{Binding HasNoAccounts, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Width="50" Height="50" HorizontalAlignment="Left" Margin="0,0,0,20">
                            <Border CornerRadius="14" Background="#122246" BorderThickness="1"
                                    BorderBrush="#25406E" />
                            <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}"
                                       FontSize="21" Foreground="{StaticResource AccentHi}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="No accounts yet" FontSize="16.5" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0"
                                   Text="Add account opens Roblox's own login page in a private browser window. You sign in there, and the app keeps the login token Roblox hands back so an alt can sign in later without you typing anything." />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                   Text="The token is sealed to your Windows account and stays on this machine." />
                        <Button Content="Add the first account" Style="{StaticResource PrimaryButton}"
                                Padding="18,9" HorizontalAlignment="Left" Margin="0,22,0,0"
                                Command="{Binding AddAccountCommand}" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" Margin="0,0,4,0" Padding="30,0,26,24"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasNoAccounts, Converter={StaticResource BoolToVis},
                                           ConverterParameter=invert}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Accounts}"
                                      ItemTemplate="{StaticResource AccountCard}" />

                        <Button Style="{StaticResource AddCard}" Content="Add another account"
                                Command="{Binding AddAccountCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DataTemplate>

        <!-- ==================================================== the host page -->
        <DataTemplate x:Key="HealthPage">
            <Grid Style="{StaticResource PageRoot}">
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="30,24,30,10">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Host health" Style="{StaticResource PageTitle}" />
                            <ContentControl Style="{StaticResource Spinner}" Margin="12,6,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsCheckingHealth, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource PageSub}"
                                   Text="Every part multi-session leans on, and what leans on what. Click a node to read it." />
                    </StackPanel>

                    <Button Content="Re-check" Padding="15,8" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Command="{Binding RefreshHealthCommand}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,26,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="520" />
                        <ColumnDefinition Width="352" />
                    </Grid.ColumnDefinitions>

                    <!-- ................................................. the web -->
                    <views:HealthWeb Grid.Column="0" Margin="24,0,10,0"
                                     Checks="{Binding HealthChecks}"
                                     Selected="{Binding SelectedCheck, Mode=TwoWay}" />

                    <!-- ........................................... the inspector -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0"
                            VerticalAlignment="Stretch">
                        <Grid>
                            <!-- Nothing picked yet: the verdict, and how to read
                                 the diagram. A legend earns its place exactly
                                 once, which is the first time somebody sees a
                                 shape they have not seen before. -->
                            <StackPanel Margin="22,22,22,22" VerticalAlignment="Top"
                                        Visibility="{Binding HasSelectedCheck,
                                                     Converter={StaticResource BoolToVis},
                                                     ConverterParameter=invert}">
                                <TextBlock Text="{Binding HealthSummary}" FontSize="16.5"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0"
                                           Text="Nothing here needs you right now. The middle of the web is multi-session itself; the ring around it is what multi-session cannot work without, and the outer ring is what only affects how well a session runs once it is up." />

                                <Border Style="{StaticResource Divider}" Margin="0,20,0,18" />

                                <TextBlock Text="READING IT" Style="{StaticResource GroupLabel}"
                                           Margin="0,0,0,12" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                    <Border Width="9" Height="9" CornerRadius="5" Margin="0,1,10,0"
                                            VerticalAlignment="Center" Background="#2DD48A" />
                                    <TextBlock Style="{StaticResource Hint}" Text="passing" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                    <Border Width="9" Height="9" CornerRadius="5" Margin="0,1,10,0"
                                            VerticalAlignment="Center" Background="#F0B23C" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="works, but something will bite later" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                    <Border Width="9" Height="9" CornerRadius="5" Margin="0,1,10,0"
                                            VerticalAlignment="Center" Background="#FF5C5C" />
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                               Width="250" HorizontalAlignment="Left"
                                               Text="blocking. Its strands run red into the middle." />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                                           Text="Windows updates can break multi-session without warning. Re-check after any update." />
                            </StackPanel>

                            <!-- Something picked: the whole story of that node. -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HasSelectedCheck,
                                                       Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="22,22,18,22">
                                    <Grid Width="42" Height="42" HorizontalAlignment="Left"
                                          Margin="0,0,0,16">
                                        <Border CornerRadius="21" BorderThickness="1"
                                                Background="{Binding SelectedCheck.State,
                                                             Converter={StaticResource Tint},
                                                             ConverterParameter=26}"
                                                BorderBrush="{Binding SelectedCheck.State,
                                                              Converter={StaticResource Tint},
                                                              ConverterParameter=66}" />
                                        <TextBlock Style="{StaticResource Glyph}" FontSize="17"
                                                   Text="{Binding SelectedCheck.State,
                                                          Converter={StaticResource HealthGlyph}}"
                                                   Foreground="{Binding SelectedCheck.State,
                                                                Converter={StaticResource HealthBrush}}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Text="{Binding SelectedCheck.Name}" FontSize="15"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />

                                    <!-- The raw value that was read, in the font
                                         raw values belong in. -->
                                    <Border Style="{StaticResource Chip}" Margin="0,12,0,0"
                                            HorizontalAlignment="Left" Padding="9,5">
                                        <TextBlock Text="{Binding SelectedCheck.Detail}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextDim}" />
                                    </Border>

                                    <TextBlock Text="WHAT IT IS" Style="{StaticResource GroupLabel}"
                                               Margin="0,20,0,8"
                                               Visibility="{Binding SelectedWhat,
                                                            Converter={StaticResource EmptyToVis}}" />
                                    <TextBlock Text="{Binding SelectedWhat}" Style="{StaticResource Body}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding SelectedWhat,
                                                            Converter={StaticResource EmptyToVis}}" />

                                    <TextBlock Text="IF IT BREAKS" Style="{StaticResource GroupLabel}"
                                               Margin="0,18,0,8"
                                               Visibility="{Binding SelectedCheck.Consequence,
                                                            Converter={StaticResource EmptyToVis}}" />
                                    <TextBlock Text="{Binding SelectedCheck.Consequence}"
                                               Style="{StaticResource Body}" TextWrapping="Wrap"
                                               Visibility="{Binding SelectedCheck.Consequence,
                                                            Converter={StaticResource EmptyToVis}}" />

                                    <Button Content="{Binding SelectedCheck.FixLabel}" Margin="0,18,0,0"
                                            HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"
                                            Padding="15,8"
                                            Visibility="{Binding SelectedCheck.CanFix,
                                                         Converter={StaticResource CanFixToVis}}"
                                            Command="{Binding ApplyFixCommand}"
                                            CommandParameter="{Binding SelectedCheck}" />

                                    <Border Style="{StaticResource Divider}" Margin="0,20,0,16"
                                            Visibility="{Binding SelectedManually,
                                                         Converter={StaticResource EmptyToVis}}" />
                                    <TextBlock Text="BY HAND" Style="{StaticResource GroupLabel}"
                                               Margin="0,0,0,8"
                                               Visibility="{Binding SelectedManually,
                                                            Converter={StaticResource EmptyToVis}}" />
                                    <TextBlock Text="{Binding SelectedManually}" Style="{StaticResource Hint}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding SelectedManually,
                                                            Converter={StaticResource EmptyToVis}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <!-- WindowChrome draws no frame of its own, so a maximised window would
         otherwise hang off every screen edge by the resize border. The margin
         is put back in code, where the real border width is known. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- One faint blue wash behind everything, top left. It is what stops a
             window this wide reading as a single flat sheet. Decorative, so it
             takes no hit tests. -->
        <Grid Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="1100" Height="820" Margin="-340,-430,0,0"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Fill="{StaticResource Aura}" />
        </Grid>

        <!-- ======================================================= title bar -->
        <Grid Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <!-- The honeycomb mark, same art as the app icon. It already
                     carries its own dark rounded tile and glow, so it needs no
                     backing Border here. -->
                <Image Source="Assets/logo.png" Width="22" Height="22"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="BSS Alt Manager" FontSize="12.5" FontWeight="SemiBold"
                           Margin="11,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,4,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}"
                        ToolTip="Minimise" Click="Minimise_Click">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE921;" />
                </Button>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}"
                        ToolTip="Maximise" Click="Maximise_Click">
                    <TextBlock x:Name="MaxGlyph" Style="{StaticResource Glyph}" Text="&#xE922;" />
                </Button>
                <Button Style="{StaticResource CloseButton}"
                        ToolTip="Close" Click="Close_Click">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================================================ body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ....................................................... rail -->
            <Border Grid.Column="0" Background="{StaticResource BgSide}"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid Margin="12,6,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="MANAGE" Style="{StaticResource GroupLabel}"
                               Margin="12,10,0,9" />

                    <Grid Grid.Row="1">
                        <!-- The marker is one Border for the whole rail rather
                             than one per item, so switching pages moves it
                             instead of blinking it out here and in again there.
                             It is positioned in code. -->
                        <Border x:Name="NavIndicator" Width="3" Height="18" CornerRadius="2"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="{StaticResource AccentHi}" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Border.RenderTransform>
                        </Border>

                        <StackPanel x:Name="NavPanel">
                            <RadioButton x:Name="NavSessions" GroupName="Nav"
                                         Style="{StaticResource NavItem}"
                                         IsChecked="{Binding IsAltsTab, Mode=TwoWay}"
                                         Checked="Nav_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE7F4;" FontSize="14"
                                               Style="{StaticResource Glyph}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="Sessions" VerticalAlignment="Center"
                                               Style="{StaticResource InheritText}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Alts.Count}"
                                               FontSize="10.5" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextFaint}" />
                                </Grid>
                            </RadioButton>

                            <RadioButton x:Name="NavAccounts" GroupName="Nav"
                                         Style="{StaticResource NavItem}"
                                         IsChecked="{Binding IsAccountsTab, Mode=TwoWay}"
                                         Checked="Nav_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE77B;" FontSize="14"
                                               Style="{StaticResource Glyph}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="Accounts" VerticalAlignment="Center"
                                               Style="{StaticResource InheritText}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Accounts.Count}"
                                               FontSize="10.5" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextFaint}" />
                                </Grid>
                            </RadioButton>

                            <RadioButton x:Name="NavHealth" GroupName="Nav"
                                         Style="{StaticResource NavItem}"
                                         IsChecked="{Binding IsHealthTab, Mode=TwoWay}"
                                         Checked="Nav_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE9D9;" FontSize="14"
                                               Style="{StaticResource Glyph}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="Host health" VerticalAlignment="Center"
                                               Style="{StaticResource InheritText}" />

                                    <!-- The only sign of trouble while you are on
                                         another page, so it is coloured rather
                                         than grey like the other two counts. -->
                                    <Border Grid.Column="2" CornerRadius="9"
                                            Padding="7,1.5" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#0D2B20" />
                                                <Setter Property="BorderBrush" Value="#1E5540" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                                        <Setter Property="Background" Value="#241C0C" />
                                                        <Setter Property="BorderBrush" Value="#4A3A17" />
                                                    </DataTrigger>
                                                    <!-- Failures listed last, so a host with both
                                                         a warning and a failure reads as failed. -->
                                                    <DataTrigger Binding="{Binding HasBlockingProblem}" Value="True">
                                                        <Setter Property="Background" Value="#2A1218" />
                                                        <Setter Property="BorderBrush" Value="#5C2431" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock Text="{Binding HealthBadge}"
                                                   FontSize="10" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasBlockingProblem}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </RadioButton>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="3">
                        <Border Style="{StaticResource HardDivider}" Margin="4,0,4,10" />

                        <Button Content="Data folder" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="11,7" Command="{Binding OpenDataFolderCommand}" />
                        <Button Content="Log" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="11,7" Command="{Binding OpenLogCommand}" />

                        <TextBlock Text="{Binding HostSummary}" Style="{StaticResource Hint}"
                                   FontSize="10.5" Margin="12,11,0,2" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- .................................................... content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Only present while something is running, and then it never
                     stops moving, which is what says a long job is still alive
                     when nothing else on screen changes. -->
                <ContentControl Grid.Row="0" Style="{StaticResource ProgressLine}"
                                Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />

                <!-- Only appears when something is actually broken. -->
                <Border Grid.Row="1" Margin="30,20,30,0" Padding="15,12" CornerRadius="10"
                        Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource DangerEdge}"
                        BorderThickness="1"
                        Visibility="{Binding BannerText, Converter={StaticResource EmptyToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="7" Height="7" CornerRadius="4"
                                Background="{StaticResource Danger}"
                                VerticalAlignment="Center" Margin="2,0,12,0" />
                        <TextBlock Grid.Column="1" Text="{Binding BannerText}" FontSize="12"
                                   LineHeight="18" TextWrapping="Wrap"
                                   Foreground="{StaticResource DangerText}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Fix it" Style="{StaticResource GhostButton}"
                                Margin="14,0,0,0" VerticalAlignment="Center"
                                Click="GoToHealth_Click" />
                    </Grid>
                </Border>

                <!-- Swapping the template rather than toggling Visibility on
                     three stacked panels: the page is rebuilt on every switch,
                     so its Loaded animation runs again and the change reads as
                     a move rather than as a repaint. -->
                <ContentControl Grid.Row="2" Content="{Binding}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource SessionsPage}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Accounts">
                                    <Setter Property="ContentTemplate" Value="{StaticResource AccountsPage}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Health">
                                    <Setter Property="ContentTemplate" Value="{StaticResource HealthPage}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </Grid>

        <!-- ====================================================== status bar -->
        <Border Grid.Row="2" Background="{StaticResource BgSide}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <Border Style="{StaticResource PulseDot}" Margin="0,0,9,0"
                        Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Status}" FontSize="11"
                           Foreground="{StaticResource TextFaint}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
