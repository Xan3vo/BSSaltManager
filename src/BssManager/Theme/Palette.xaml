<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======================================================== palette =====
         Black and blue. The ground is genuinely near black rather than dark
         navy, and every surface above it is a deliberate step up, so depth
         comes from the stack of tones and a hairline edge rather than from
         drop shadows.

         That is not only taste. A WPF Effect renders its whole subtree into an
         intermediate surface, and text in that subtree drops from ClearType to
         grey antialiasing. Card shadows used to sit on the Border holding the
         card's own text, which is what made the app look soft. Nothing
         carrying text has an Effect any more; glows live on empty Borders. -->

    <SolidColorBrush x:Key="Bg"          Color="#06080C" />
    <SolidColorBrush x:Key="BgSide"      Color="#0A0D14" />
    <SolidColorBrush x:Key="Surface"     Color="#0E121B" />
    <SolidColorBrush x:Key="Surface2"    Color="#131926" />
    <SolidColorBrush x:Key="Surface3"    Color="#1A2131" />
    <SolidColorBrush x:Key="Surface4"    Color="#222B3E" />

    <SolidColorBrush x:Key="Line"        Color="#1E2634" />
    <SolidColorBrush x:Key="LineStrong"  Color="#2B3648" />
    <SolidColorBrush x:Key="LineSoft"    Color="#151B26" />

    <SolidColorBrush x:Key="Text"        Color="#E9EEF8" />
    <SolidColorBrush x:Key="TextDim"     Color="#95A2BA" />
    <SolidColorBrush x:Key="TextFaint"   Color="#606C84" />

    <SolidColorBrush x:Key="Accent"      Color="#2F6BFF" />
    <SolidColorBrush x:Key="AccentHi"    Color="#5C8CFF" />
    <SolidColorBrush x:Key="AccentLo"    Color="#1B4AD1" />
    <SolidColorBrush x:Key="AccentSoft"  Color="#122246" />
    <SolidColorBrush x:Key="AccentEdge"  Color="#2A4A8E" />

    <SolidColorBrush x:Key="Ok"          Color="#2DD48A" />
    <SolidColorBrush x:Key="Warn"        Color="#F0B23C" />
    <SolidColorBrush x:Key="Danger"      Color="#FF5C5C" />

    <SolidColorBrush x:Key="DangerSoft"  Color="#25121A" />
    <SolidColorBrush x:Key="DangerEdge"  Color="#5C2431" />
    <SolidColorBrush x:Key="DangerText"  Color="#FFB4B4" />

    <!-- ================================================ depth and light ==== -->

    <!-- One faint blue wash in the top left corner. Enough to stop a wide
         window reading as a single flat sheet, not enough to notice as a
         shape. Alpha is in the colour, so it needs no opacity mask. -->
    <RadialGradientBrush x:Key="Aura">
        <GradientStop Color="#282F6BFF" Offset="0" />
        <GradientStop Color="#0E2F6BFF" Offset="0.5" />
        <GradientStop Color="#002F6BFF" Offset="1" />
    </RadialGradientBrush>

    <!-- Dialogs sit on their own transparent window, so this one is fully
         opaque rather than tinted by whatever happens to be behind it. -->
    <LinearGradientBrush x:Key="DialogBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#171E2D" Offset="0" />
        <GradientStop Color="#0E121B" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DialogEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3A465E" Offset="0" />
        <GradientStop Color="#1E2634" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LogoFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6C9BFF" Offset="0" />
        <GradientStop Color="#2447D6" Offset="1" />
    </LinearGradientBrush>

    <!-- A hairline that fades out at both ends instead of stopping dead. -->
    <LinearGradientBrush x:Key="FadingLine" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#001E2634" Offset="0" />
        <GradientStop Color="#2B3648" Offset="0.5" />
        <GradientStop Color="#001E2634" Offset="1" />
    </LinearGradientBrush>

    <!-- Glows. Only ever applied to a Border with no children. -->
    <DropShadowEffect x:Key="AccentGlow" BlurRadius="18" ShadowDepth="0"
                      Color="#2F6BFF" Opacity="0.5" />
    <DropShadowEffect x:Key="DangerGlow" BlurRadius="18" ShadowDepth="0"
                      Color="#FF4A4A" Opacity="0.45" />
    <DropShadowEffect x:Key="OkGlow" BlurRadius="16" ShadowDepth="0"
                      Color="#2DD48A" Opacity="0.45" />

    <!-- ============================================== type and timing =====

         Segoe UI Variable Text is the Windows 11 UI face, and using it is a
         large part of what makes this read as native rather than as a web
         page in a box. -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Shared timings, so nothing feels out of step with anything else. -->
    <Duration x:Key="Instant">0:0:0.09</Duration>
    <Duration x:Key="Fast">0:0:0.15</Duration>
    <Duration x:Key="Medium">0:0:0.26</Duration>
    <Duration x:Key="Slow">0:0:0.42</Duration>

    <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
    <QuarticEase x:Key="EaseOutStrong" EasingMode="EaseOut" />

    <!-- ==================================================== typography ===== -->

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- Two styles that deliberately do NOT derive from the implicit one
         above, because deriving from it is the whole problem.

         A style setter beats an inherited value. The implicit TextBlock style
         sets Foreground, so any TextBlock inside a Button or a RadioButton
         ignores the colour its parent is animating and stays one fixed grey.
         It also sets FontFamily, which is what turned every glyph handed to a
         Button as a bare string into a tofu box. Setting only what is needed
         and letting the rest inherit is what fixes both. -->
    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="InheritText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style x:Key="PageSub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
        <Setter Property="Margin" Value="0,5,0,0" />
    </Style>

    <!-- Small, quiet and spaced out: reads as a label for the block under it
         rather than as a heading competing with one. -->
    <Style x:Key="GroupLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- ========================================================= parts =====

         Cards carry no Effect. Elevation is the step from the panel tone to
         the card tone plus a one pixel edge, which is both cleaner at this
         scale and the only way text on them keeps subpixel antialiasing. -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Fades and lifts a card in as it is created, so a list does not snap
         into place. The element needs a TranslateTransform of its own. -->
    <Style x:Key="FadeInCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="{StaticResource Medium}" />
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                         From="10" To="0" Duration="{StaticResource Slow}"
                                         EasingFunction="{StaticResource EaseOutStrong}" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- One fact, boxed. A row of these scans in a way that the same facts
         joined by spaces into one long grey sentence never did. -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="#0E1420" />
        <Setter Property="BorderBrush" Value="#202939" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource FadingLine}" />
    </Style>

    <Style x:Key="HardDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource Line}" />
    </Style>

</ResourceDictionary>
