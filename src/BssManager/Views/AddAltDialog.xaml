<Window x:Class="BssManager.Views.AddAltDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add alt"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal">

    <!-- AllowsTransparency turns ClearType off for the whole window. The
         background behind this text is opaque, so the hint is safe and puts
         subpixel antialiasing back. -->
    <Border RenderOptions.ClearTypeHint="Enabled"
            Background="{StaticResource DialogBrush}" CornerRadius="14"
            BorderBrush="{StaticResource DialogEdge}" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="{StaticResource Fast}" />
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                         From="0.97" To="1" Duration="{StaticResource Medium}"
                                         EasingFunction="{StaticResource EaseOutStrong}" />
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                         From="0.97" To="1" Duration="{StaticResource Medium}"
                                         EasingFunction="{StaticResource EaseOutStrong}" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- =================================================== header -->
            <Grid Grid.Row="0" Margin="26,20,16,0">
                <StackPanel Margin="0,0,40,0">
                    <TextBlock Text="Add an alt" FontSize="17.5" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,7,0,0"
                               Text="Creates a local Windows account, generates a password for it, saves that password so the session logs in unattended, and writes a connection file with the size pinned." />
                </StackPanel>

                <Button Style="{StaticResource DialogClose}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" ToolTip="Cancel" Click="Cancel_Click">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BB;" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Divider}" Margin="26,20,26,0" />

            <!-- ==================================================== fields -->
            <StackPanel Grid.Row="2" Margin="26,20,26,22">

                <TextBlock Text="Label" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="DisplayNameBox" />
                <TextBlock Style="{StaticResource Hint}" Margin="2,7,0,0"
                           Text="Shown in the list. Anything you like, such as &quot;Alt 1 - gifted bear&quot;." />

                <TextBlock Text="Windows account name" Style="{StaticResource FieldLabel}"
                           Margin="0,18,0,6" />
                <TextBox x:Name="UsernameBox" TextChanged="UsernameBox_TextChanged" />
                <TextBlock x:Name="UsernameNote" Style="{StaticResource Hint}" Margin="2,7,0,0"
                           Text="Letters and numbers only, no spaces." />

                <TextBlock Text="Session size" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                <ComboBox x:Name="ResolutionBox" SelectedIndex="0"
                          SelectionChanged="ResolutionBox_SelectionChanged">
                    <ComboBoxItem Content="1280 x 720" Tag="1280x720" />
                    <ComboBoxItem Content="1600 x 900" Tag="1600x900" />
                    <ComboBoxItem Content="1920 x 1080" Tag="1920x1080" />
                    <ComboBoxItem Content="Custom" Tag="custom" />
                </ComboBox>

                <StackPanel x:Name="CustomSizePanel" Orientation="Horizontal" Visibility="Collapsed"
                            Margin="0,9,0,0">
                    <TextBox x:Name="CustomWidthBox" Width="88" Text="1280" />
                    <TextBlock Text="x" Margin="10,9,10,0" Foreground="{StaticResource TextFaint}" />
                    <TextBox x:Name="CustomHeightBox" Width="88" Text="720" />
                </StackPanel>

                <TextBlock Style="{StaticResource Hint}" Margin="2,8,0,0"
                           Text="Keep this identical across every alt running the same macro. Pixel-based macros are tuned to one size, and changing it later means retuning them." />

                <Border Style="{StaticResource Divider}" Margin="0,20,0,0" />

                <CheckBox x:Name="HideFromLoginBox" IsChecked="True" Margin="0,18,0,0"
                          Content="Hide this account from the Windows sign-in screen" />
                <TextBlock Style="{StaticResource Hint}" Margin="29,6,0,0"
                           Text="It is only ever used over loopback, so there is no reason for it to clutter your lock screen." />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="Cancel" Padding="18,9" Margin="0,0,9,0"
                            IsCancel="True" Click="Cancel_Click" />
                    <Button x:Name="CreateButton" Content="Create alt" Padding="22,9" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Create_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
