<Window x:Class="BssManager.Views.MacroDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Macro"
        Width="680" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Window.Resources>

    <!-- AllowsTransparency turns ClearType off for the whole window. The
         background behind this text is opaque, so the hint is safe and puts
         subpixel antialiasing back. -->
    <Border RenderOptions.ClearTypeHint="Enabled"
            Background="{StaticResource DialogBrush}" CornerRadius="14"
            BorderBrush="{StaticResource DialogEdge}" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="{StaticResource Fast}" />
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                         From="0.97" To="1" Duration="{StaticResource Medium}"
                                         EasingFunction="{StaticResource EaseOutStrong}" />
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                         From="0.97" To="1" Duration="{StaticResource Medium}"
                                         EasingFunction="{StaticResource EaseOutStrong}" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- =================================================== header -->
            <Grid Grid.Row="0" Margin="26,20,16,0">
                <StackPanel Margin="0,0,40,0">
                    <TextBlock x:Name="HeaderText" Text="Macro" FontSize="17.5" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,7,0,0"
                               Text="Kairos runs inside this session and plays the game. Launching this RDP joins the server below and starts the macro on its own." />
                </StackPanel>

                <Button Style="{StaticResource DialogClose}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" ToolTip="Cancel" Click="Cancel_Click">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BB;" />
                </Button>
            </Grid>

            <!-- =============================================== install row -->
            <Border Grid.Row="1" Margin="26,18,26,0" Padding="15,13" CornerRadius="10"
                    Background="{StaticResource Surface2}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="InstallDot" Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                            VerticalAlignment="Center" Margin="2,0,13,0"
                            Background="{StaticResource TextFaint}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="InstallTitle" FontSize="12.5" FontWeight="SemiBold"
                                   Text="Checking..." />
                        <TextBlock x:Name="InstallDetail" Style="{StaticResource Hint}"
                                   Margin="0,4,14,0" Text="" />
                    </StackPanel>

                    <Button x:Name="InstallButton" Grid.Column="2" Content="Set up macro"
                            Style="{StaticResource PrimaryButton}" Padding="16,8"
                            VerticalAlignment="Center" Click="Install_Click" />
                </Grid>
            </Border>

            <!-- ================================================== settings -->
            <Grid x:Name="SettingsArea" Grid.Row="2" Margin="26,20,26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ......................................... the account -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="This alt" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Alt number" Style="{StaticResource FieldLabel}"
                                       ToolTip="Kairos staggers alts by this, so two alts sharing a number will crowd the same spot." />
                            <TextBox x:Name="AltNumberBox" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hive slot" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="HiveSlotBox" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Text="Walkspeed" Style="{StaticResource FieldLabel}"
                                   ToolTip="What the macro assumes this account moves at. Wrong here and every path overshoots." />
                        <TextBox x:Name="MovespeedBox" />
                    </StackPanel>

                    <CheckBox x:Name="ClaimHiveBox" Content="Claim the hive on start" Margin="0,4,0,11" />
                    <CheckBox x:Name="ShiftLockBox" Content="Shift lock" Margin="0,0,0,11" />
                    <CheckBox x:Name="UseToolBox" Content="Use tool" />
                </StackPanel>

                <!-- ....................................... the gathering -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Gathering" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Text="Field" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="FieldBox" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Text="Pattern" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="PatternBox" />
                    </StackPanel>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Pattern size" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="PatternSizeBox" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Pattern width" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="PatternWidthBox" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Text="Sprinkler" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="SprinklerBox" Grid.Column="0" />
                            <TextBox x:Name="SprinklerDistanceBox" Grid.Column="2"
                                     ToolTip="Distance from the sprinkler." />
                        </Grid>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Rotation" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="RotationBox" Grid.Column="0" />
                            <TextBox x:Name="RotationAmountBox" Grid.Column="2"
                                     ToolTip="How much to rotate. 0 for none." />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ==================================================== server -->
            <StackPanel Grid.Row="3" Margin="26,0,26,22">

                <Border Style="{StaticResource Divider}" Margin="0,20,0,16" />

                <TextBlock Text="Private server link" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="LinkBox" TextChanged="LinkBox_TextChanged" />

                <TextBlock Style="{StaticResource Hint}" Margin="2,7,0,0"
                           Text="The long roblox.com/games/... address with privateServerLinkCode in it. Leave it empty to join public servers. A short roblox.com/share link will not work: open it first and copy where it lands." />

                <!-- Only ever visible with something to say. -->
                <Border x:Name="ProblemBox" Margin="0,12,0,0" Padding="13,10" CornerRadius="8"
                        Background="{StaticResource DangerSoft}"
                        BorderBrush="{StaticResource DangerEdge}" BorderThickness="1"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ProblemText" FontSize="11.5" LineHeight="18"
                               TextWrapping="Wrap" Foreground="{StaticResource DangerText}" />
                </Border>

                <CheckBox x:Name="ApplyToAllBox" Content="Use this private server for every RDP"
                          Margin="0,16,0,0" />

                <Grid Margin="0,20,0,0">
                    <TextBlock x:Name="InstallProblem" VerticalAlignment="Center" FontSize="11.5"
                               TextWrapping="Wrap" Foreground="{StaticResource DangerText}" Text=""
                               HorizontalAlignment="Left" Margin="0,0,160,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource GhostButton}"
                                Padding="16,9" Margin="0,0,8,0" Click="Cancel_Click" />
                        <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}"
                                Padding="20,9" Click="Save_Click" IsDefault="True" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
